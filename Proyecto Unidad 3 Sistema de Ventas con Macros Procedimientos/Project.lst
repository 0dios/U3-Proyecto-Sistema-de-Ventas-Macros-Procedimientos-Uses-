 000009F3  43				inc ebx

 000009F4  83 FB 07			cmp ebx, 7
 000009F7  72 EF			jb verificacionNumeros

 000009F9  8A 04 1F			mov al, [edi + ebx] ;no puede haber un octavo caracter
 000009FC  3C 00			cmp al, 0
 000009FE  75 07			jne caracteresInvalidos

 00000A00  B8 00000000			mov eax, 0
 00000A05  EB 05			jmp fin

 00000A07			caracteresInvalidos:
 00000A07  B8 00000001			mov eax, 1
 00000A0C			fin:
					ret
 00000A0C  5B		   *	    pop    ebx
 00000A0D  C3		   *	    ret    00000h
 00000A0E			verificarCodigoProducto ENDP

